{"fa":{"name":"Persian alphabet","intro":"Persian (Farsi) is written from right to left with 32 letters. Most letters join the next letter in a word, so their shape changes a little with their position.","sections":[{"id":"letters","title":"The 32 letters","note":"Each letter can have four shapes: alone, at the start, in the middle and at the end of a word.","cols":4,"cells":[{"g":"ا","name":"alef","r":"ā","ipa":"/ɒː/","forms":["ا","ا","ـا","ـا"],"joins":false,"ex":{"w":"انار","v":"اَنارْ","r":"anār","m":"pomegranate","a":"86d73323f6d3"}},{"g":"ب","name":"be","r":"b","ipa":"/b/","forms":["ب","بـ","ـبـ","ـب"],"joins":true,"ex":{"w":"باران","v":"بارانْ","r":"bārān","m":"rain","a":"b989f302febe"}},{"g":"پ","name":"pe","r":"p","ipa":"/p/","forms":["پ","پـ","ـپـ","ـپ"],"joins":true,"ex":{"w":"پدر","v":"پِدَرْ","r":"pedar","m":"father","a":"e37b2419cefa"}},{"g":"ت","name":"te","r":"t","ipa":"/t/","forms":["ت","تـ","ـتـ","ـت"],"joins":true,"ex":{"w":"توپ","v":"توپْ","r":"tup","m":"ball","a":"54ad0ade30fc"}},{"g":"ث","name":"se","r":"s","ipa":"/s/","forms":["ث","ثـ","ـثـ","ـث"],"joins":true,"ex":{"w":"ثروت","v":"ثِرْوَتْ","r":"servat","m":"wealth","a":"6eeb1d26eccb"}},{"g":"ج","name":"jim","r":"j","ipa":"/dʒ/","forms":["ج","جـ","ـجـ","ـج"],"joins":true,"ex":{"w":"جنگل","v":"جَنْگَلْ","r":"jangal","m":"forest","a":"7d45bf22c311"}},{"g":"چ","name":"che","r":"ch","ipa":"/tʃ/","forms":["چ","چـ","ـچـ","ـچ"],"joins":true,"ex":{"w":"چای","v":"چایْ","r":"chāy","m":"tea","a":"95038e27da4f"}},{"g":"ح","name":"he-ye jimi","r":"h","ipa":"/h/","forms":["ح","حـ","ـحـ","ـح"],"joins":true,"ex":{"w":"حرف","v":"حَرْفْ","r":"harf","m":"letter; word","a":"af83f89df87e"}},{"g":"خ","name":"khe","r":"kh","ipa":"/x/","forms":["خ","خـ","ـخـ","ـخ"],"joins":true,"ex":{"w":"خوب","v":"خوبْ","r":"khub","m":"good","a":"e9220bfb8a5d"}},{"g":"د","name":"dāl","r":"d","ipa":"/d/","forms":["د","د","ـد","ـد"],"joins":false,"ex":{"w":"دست","v":"دَسْتْ","r":"dast","m":"hand","a":"eeb441556ac9"}},{"g":"ذ","name":